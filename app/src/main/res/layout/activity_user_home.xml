<?xml version="1.0" encoding="utf-8"?>
<!-- User home layout -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- Modern Location Header -->
    <LinearLayout
        android:id="@+id/homeHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:background="@android:color/white">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:id="@+id/locationPicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_centerVertical="true">
                <TextView 
                    android:layout_width="wrap_content" 
                    android:layout_height="wrap_content" 
                    android:text="DELIVERING TO" 
                    android:textSize="10sp" 
                    android:textStyle="bold" 
                    android:textColor="#757575"
                    android:letterSpacing="0.05" />
                <LinearLayout 
                    android:layout_width="wrap_content" 
                    android:layout_height="wrap_content" 
                    android:gravity="center_vertical">
                    <TextView 
                        android:id="@+id/currentLocationTv"
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:text="Home - Kathmandu, Nepal" 
                        android:textStyle="bold" 
                        android:textColor="#212121" 
                        android:textSize="14sp" />
                    <ImageView 
                        android:layout_width="16dp" 
                        android:layout_height="16dp" 
                        android:src="@drawable/ic_chevron_right" 
                        app:tint="#757575" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/notification_bell"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/circle_background"
                android:backgroundTint="#F5F5F5"
                android:padding="6dp"
                android:src="@drawable/ic_notifications"
                app:tint="#424242"/>
        </RelativeLayout>

        <!-- Integrated Modern Search Bar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnSearchField"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F1F3F4">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/search_icon" app:tint="#5F6368"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Search for 'organics'..." android:layout_marginStart="12dp" android:textColor="#5F6368" android:textSize="14sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">



                 <!-- Banner Carousel -->
                 <androidx.viewpager2.widget.ViewPager2
                     android:id="@+id/bannerViewPager"
                     android:layout_width="match_parent"
                     android:layout_height="250dp"
                     android:layout_marginBottom="8dp" />

                 <com.google.android.material.tabs.TabLayout
                     android:id="@+id/bannerIndicator"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:layout_gravity="center_horizontal"
                     android:layout_marginBottom="16dp"
                     app:tabBackground="@drawable/tab_indicator_selector"
                     app:tabGravity="center"
                     app:tabIndicatorHeight="0dp" />

                 <!-- Quick Access Dashboard -->
                 <LinearLayout
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content"
                     android:orientation="horizontal"
                     android:layout_marginHorizontal="16dp"
                     android:layout_marginBottom="24dp"
                     android:gravity="center"
                     android:weightSum="4">

                     <!-- Wallet Item -->
                     <LinearLayout
                         android:id="@+id/walletCard"
                         android:layout_width="0dp"
                         android:layout_height="wrap_content"
                         android:layout_weight="1"
                         android:orientation="vertical"
                         android:gravity="center"
                         android:background="?attr/selectableItemBackground"
                         android:clickable="true">
                         <com.google.android.material.card.MaterialCardView
                             android:layout_width="52dp"
                             android:layout_height="52dp"
                             app:cardCornerRadius="26dp"
                             app:cardElevation="0dp"
                             app:cardBackgroundColor="#E3F2FD">
                             <ImageView
                                 android:layout_width="26dp"
                                 android:layout_height="26dp"
                                 android:layout_gravity="center"
                                 android:src="@drawable/wallet" />
                         </com.google.android.material.card.MaterialCardView>
                         <TextView
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:text="Wallet"
                             android:textSize="11sp"
                             android:textColor="#424242"
                             android:layout_marginTop="6dp"/>
                     </LinearLayout>

                     <!-- Vendor Map Item -->
                     <LinearLayout
                         android:id="@+id/exploreVendorsCard"
                         android:layout_width="0dp"
                         android:layout_height="wrap_content"
                         android:layout_weight="1"
                         android:orientation="vertical"
                         android:gravity="center"
                         android:background="?attr/selectableItemBackground"
                         android:clickable="true">
                         <com.google.android.material.card.MaterialCardView
                             android:layout_width="52dp"
                             android:layout_height="52dp"
                             app:cardCornerRadius="26dp"
                             app:cardElevation="0dp"
                             app:cardBackgroundColor="#E8F5E9">
                             <ImageView
                                 android:layout_width="26dp"
                                 android:layout_height="26dp"
                                 android:layout_gravity="center"
                                 android:src="@drawable/store" />
                         </com.google.android.material.card.MaterialCardView>
                         <TextView
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:text="Stores"
                             android:textSize="11sp"
                             android:textColor="#424242"
                             android:layout_marginTop="6dp"/>
                     </LinearLayout>

                     <!-- Offers Item -->
                     <LinearLayout
                         android:id="@+id/offersBtn"
                         android:layout_width="0dp"
                         android:layout_height="wrap_content"
                         android:layout_weight="1"
                         android:orientation="vertical"
                         android:gravity="center"
                         android:background="?attr/selectableItemBackground"
                         android:clickable="true">
                         <com.google.android.material.card.MaterialCardView
                             android:layout_width="52dp"
                             android:layout_height="52dp"
                             app:cardCornerRadius="26dp"
                             app:cardElevation="0dp"
                             app:cardBackgroundColor="#FFF3E0">
                             <ImageView
                                 android:layout_width="26dp"
                                 android:layout_height="26dp"
                                 android:layout_gravity="center"
                                 android:src="@drawable/offer" />
                         </com.google.android.material.card.MaterialCardView>
                         <TextView
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:text="Offers"
                             android:textSize="11sp"
                             android:textColor="#424242"
                             android:layout_marginTop="6dp"/>
                     </LinearLayout>

                     <!-- Support Item -->
                     <LinearLayout
                         android:id="@+id/supportBtn"
                         android:layout_width="0dp"
                         android:layout_height="wrap_content"
                         android:layout_weight="1"
                         android:orientation="vertical"
                         android:gravity="center"
                         android:background="?attr/selectableItemBackground"
                         android:clickable="true">
                         <com.google.android.material.card.MaterialCardView
                             android:layout_width="52dp"
                             android:layout_height="52dp"
                             app:cardCornerRadius="26dp"
                             app:cardElevation="0dp"
                             app:cardBackgroundColor="#F3E5F5">
                             <ImageView
                                 android:layout_width="26dp"
                                 android:layout_height="26dp"
                                 android:layout_gravity="center"
                                 android:src="@drawable/support" />
                         </com.google.android.material.card.MaterialCardView>
                         <TextView
                             android:layout_width="wrap_content"
                             android:layout_height="wrap_content"
                             android:text="Support"
                             android:textSize="11sp"
                             android:textColor="#424242"
                             android:layout_marginTop="6dp"/>
                     </LinearLayout>
                 </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/freeDeliveryGoalCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E8F5E9"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="#E8F5E9">
                        <TextView
                            android:id="@+id/freeDeliveryTv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Add Rs. 200 more for FREE delivery"
                            android:textColor="#2E7D32"
                            android:textStyle="bold"
                            android:textSize="13sp"/>
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/freeDeliveryProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:indicatorColor="#00C853"
                            app:trackColor="#C8E6C9"
                            app:trackThickness="6dp"
                            app:trackCornerRadius="3dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Delivery Time & Buy Again Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical">
                    
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFF3E0">
                        <TextView
                            android:id="@+id/deliveryTimeTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:text="20 mins"
                            android:textColor="#E65100"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            app:drawableStartCompat="@android:drawable/ic_dialog_info"
                            app:drawableTint="#E65100"
                            android:drawablePadding="4dp"/>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Recent Orders -->
                <LinearLayout
                    android:id="@+id/recentOrdersSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="24dp">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginBottom="12dp">
                        <TextView 
                            android:layout_width="wrap_content" 
                            android:layout_height="wrap_content" 
                            android:text="Recent Orders" 
                            android:textSize="18sp" 
                            android:fontFamily="sans-serif-black"
                            android:textColor="#212121"/>
                        <TextView
                            android:id="@+id/btnViewAllOrders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="View All"
                            android:textColor="#00C853"
                            android:textStyle="bold"
                            android:textSize="14sp"/>
                    </RelativeLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recentOrdersRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:clipToPadding="false"/>
                </LinearLayout>

                <!-- Recently Viewed Products -->
                <LinearLayout
                    android:id="@+id/recentlyViewedSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="24dp">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginBottom="12dp">
                        <TextView 
                            android:layout_width="wrap_content" 
                            android:layout_height="wrap_content" 
                            android:text="Recently Viewed" 
                            android:textSize="18sp" 
                            android:fontFamily="sans-serif-black"
                            android:textColor="#212121"/>
                    </RelativeLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recentlyViewedRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:clipToPadding="false"/>
                </LinearLayout>

                 <!-- Shop by Category -->
                 <RelativeLayout
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content"
                     android:layout_marginHorizontal="16dp"
                     android:layout_marginBottom="12dp">
                     <TextView 
                         android:layout_width="wrap_content" 
                         android:layout_height="wrap_content" 
                         android:text="Shop by Category" 
                         android:textSize="18sp" 
                         android:fontFamily="sans-serif-black"
                         android:textColor="#212121"/>
                 </RelativeLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/categoriesRv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:clipToPadding="false"
                    android:layout_marginBottom="24dp"/>

                <!-- Buy Again -->
                <LinearLayout
                    android:id="@+id/buyAgainSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="24dp">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginBottom="12dp">
                        <TextView 
                            android:layout_width="wrap_content" 
                            android:layout_height="wrap_content" 
                            android:text="Buy Again" 
                            android:textSize="18sp" 
                            android:fontFamily="sans-serif-black"
                            android:textColor="#212121"/>
                    </RelativeLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/buyAgainRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:clipToPadding="false"/>
                </LinearLayout>

                <!-- Recommended for You -->
                <LinearLayout
                    android:id="@+id/recommendationSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginBottom="12dp">
                        <TextView 
                            android:layout_width="wrap_content" 
                            android:layout_height="wrap_content" 
                            android:text="Recommended for You" 
                            android:textSize="18sp" 
                            android:fontFamily="sans-serif-black"
                            android:textColor="#212121"/>
                    </RelativeLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recommendedRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:clipToPadding="false"/>
                </LinearLayout>

                <!-- Featured Products -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="12dp">
                    <TextView 
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:text="Handpicked for You" 
                        android:textSize="18sp" 
                        android:fontFamily="sans-serif-black"
                        android:textColor="#212121"/>
                </RelativeLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/featuredRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:clipToPadding="false"
                    android:layout_marginBottom="24dp"/>

                <!-- All Products Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_marginBottom="12dp">
                    <TextView 
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:text="All Products" 
                        android:textSize="18sp" 
                        android:fontFamily="sans-serif-black"
                        android:textColor="#212121"/>
                    <ImageView
                        android:id="@+id/sortIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:src="@drawable/sort_icon"
                        app:tint="#00C853"/>
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/allProductsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:nestedScrollingEnabled="false"/>

            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <include layout="@layout/bottom_navigation_custom" />

</LinearLayout>