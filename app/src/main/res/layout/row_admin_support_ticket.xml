<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ticketSubjectTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ticket Subject"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/ticketStatusTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPEN"
                android:textStyle="bold"
                android:textColor="#F44336" />
        </LinearLayout>

        <TextView
            android:id="@+id/userInfoTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User: 101 | Order: #502"
            android:textSize="12sp"
            android:textColor="#666666" />

        <TextView
            android:id="@+id/dateTypeTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jan 26, 2026 | Type: Damaged"
            android:textSize="11sp"
            android:textColor="#999999" />

        <TextView
            android:id="@+id/ticketDescTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description goes here..."
            android:layout_marginTop="8dp" />

        <ImageView
            android:id="@+id/issueIv"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="fitCenter"
            android:layout_marginTop="12dp"
            android:background="#EEEEEE"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/actionsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/refundBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Refund Wallet"
                app:backgroundTint="#4CAF50"
                android:layout_marginEnd="8dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resolveBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mark Resolved"
                app:backgroundTint="#2196F3"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
